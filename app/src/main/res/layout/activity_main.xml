<?xml version="1.0" encoding="utf-8"?>
<!--
    首页。视觉参考：一张宣纸，左上角三个星号，正中一行打字机体的 No Feed。
    功能一点没动：还是输入框 + 平台 + 搜索按钮。

    输入框是纯底线样式（FilledBox + 透明底色），像是直接在纸上写，
    比原来的方框更贴合「纸」的气质，同时保留焦点反馈和清除按钮。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_paper"
    android:orientation="vertical">

    <!-- 顶行：星号 + 设置 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:fontFamily="monospace"
            android:letterSpacing="0.28"
            android:text="@string/brand_mark"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_settings"
            android:src="@drawable/ic_settings"
            app:tint="?attr/colorOnSurfaceVariant" />
    </FrameLayout>

    <!-- 报头 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.18"
        android:text="@string/brand_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="26sp" />

    <!-- 搜索框：无底色、无边框，只有一条底线 —— 像是直接在纸上写 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/keywordLayout"
        style="@style/Widget.Material3.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:hint="@string/home_hint"
        app:boxBackgroundMode="none"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/keywordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="2"
            android:minHeight="48dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 那条线。焦点变化不改变它，保持纸面安静 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

    <!-- 平台单选：横向可滑 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/platformGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- 首页没有任何可用平台时显示 -->
    <TextView
        android:id="@+id/emptyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/empty_no_platform"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/searchButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="22dp"
        android:enabled="false"
        android:text="@string/action_search"
        android:textSize="16sp"
        app:cornerRadius="2dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="@string/footer_note"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

</LinearLayout>
