# 统一换行符，避免 Windows 提交、Mac/Linux 检出时整文件 diff
* text=auto eol=lf

*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.properties text eol=lf
gradlew text eol=lf

*.bat   text eol=crlf

# 二进制文件不要做换行转换
*.png   binary
*.jar   binary
*.apk   binary
