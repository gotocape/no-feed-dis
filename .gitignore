# ---------- Android / Gradle 构建产物 ----------
# 这些是可再生的，提交上去只会让仓库暴涨（本项目 app/build 单目录就 66MB）
.gradle/
build/
app/build/
captures/
.externalNativeBuild/
.cxx/

# ---------- 本机配置 ----------
# local.properties 里是本机的 Android SDK 绝对路径，
# 换台电脑就失效，必须由每个人自己生成（Android Studio 打开工程时会自动写）
local.properties

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/

# ---------- 打包产物 ----------
# APK 不进版本库，改用 GitHub Releases 分发。
# 理由：每次发版都往历史里塞 4~7MB 二进制，仓库会越来越大且无法瘦身。
dist/*.apk

# 但保留 dist 目录本身（README 里引用了它）
!dist/.gitkeep

# ---------- 系统与临时文件 ----------
.DS_Store
Thumbs.db
desktop.ini
*.log
ui.xml
